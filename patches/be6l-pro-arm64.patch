diff --git a/target/linux/airoha/patches-6.18/038-arm64-airoha-add-an7563-soc-selection.patch b/target/linux/airoha/patches-6.18/038-arm64-airoha-add-an7563-soc-selection.patch
new file mode 100644
index 0000000..eea279a
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/038-arm64-airoha-add-an7563-soc-selection.patch
@@ -0,0 +1,16 @@
+Subject: [PATCH] arm64: airoha: add AN7563 SoC selection
+
+Expose the AN7563 selection on arm64 so natflow keeps using the
+SoC-specific SRAM hash path on both architectures.
+
+--- a/arch/arm64/Kconfig.platforms
++++ b/arch/arm64/Kconfig.platforms
+@@ -18 +18,8 @@
++config SOC_AIROHA_AN7563
++	bool "Airoha AN7563 / AN7552 SoC"
++	depends on ARCH_AIROHA
++	help
++	  Select this for Airoha AN7563 / AN7552 SoCs to enable the
++	  SoC-specific hardware offload path.
++
+ config ARCH_SUNXI
diff --git a/target/linux/airoha/patches-6.18/203-pinctrl-airoha-add-support-for-AN7563-pins.patch b/target/linux/airoha/patches-6.18/203-pinctrl-airoha-add-support-for-AN7563-pins.patch
index 8dc05fd..3d90511 100644
--- a/target/linux/airoha/patches-6.18/203-pinctrl-airoha-add-support-for-AN7563-pins.patch
+++ b/target/linux/airoha/patches-6.18/203-pinctrl-airoha-add-support-for-AN7563-pins.patch
